{
  "manifest_version": 3,
  "name": "Auto Zoom Manager",
  "version": "1.0",
  "description": "Auto adjusts website zoom based on monitor size",
  "permissions": [],
  "action": {
    "default_popup": "index.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"]
    }
  ]
}